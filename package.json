{
  "name": "@dreamdesk/player",
  "version": "0.1.1",
  "description": "A Winamp-style music player for React, built on @dreamdesk/ui: playlist, 7-band EQ with presets, skins, and a visualizer.",
  "keywords": [
    "winamp",
    "music-player",
    "audio",
    "equalizer",
    "visualizer",
    "react",
    "dreamdesk",
    "retro"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stonedem0/dreamdesk-player.git"
  },
  "homepage": "https://github.com/stonedem0/dreamdesk-player#readme",
  "bugs": {
    "url": "https://github.com/stonedem0/dreamdesk-player/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/style.css",
    "./visualizer": "./visualizer.js",
    "./core": "./core/index.js"
  },
  "files": [
    "dist",
    "core",
    "!core/__checks__",
    "!core/__tests__",
    "visualizer.js",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:core": "node core/__checks__/equivalence.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@dreamdesk/ui": ">=3.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@dreamdesk/ui": "^3.1.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.5"
  }
}
